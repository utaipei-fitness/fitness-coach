{
  "name": "fitness-coach",
  "private": true,
  "version": "0.0.0",
  "description": "即時健身操動作比對系統",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-mediapipe.mjs",
    "predev": "node scripts/setup-mediapipe.mjs",
    "dev": "vite",
    "predev:phone": "node scripts/setup-mediapipe.mjs",
    "dev:phone": "vite --host --mode phone",
    "prebuild": "node scripts/setup-mediapipe.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check": "npm run typecheck && vitest run",
    "clips": "node scripts/export-clips.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
