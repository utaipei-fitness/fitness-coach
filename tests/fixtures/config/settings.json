// ═══════════════════════════════════════════════
// 全域設定：所有步驟共用的預設值
// - 可以用 // 寫註解，最後一項後面多一個逗號也沒關係
// - 存檔後網頁會自動重新載入；寫錯會在畫面上用中文指出位置
// - routine.json 裡個別步驟有寫的值，會覆蓋這裡的預設值
// ═══════════════════════════════════════════════
{
  // ── 判定標準 ──
  "judge": {
    "toleranceDeg": 20,     // 預設容許角度：與標準相差 ±20 度以內算達標
    "extraToleranceDeg": 0,  // 整體放寬：所有角度（包括 routine.json 個別設定的）都再多容許這麼多度；0 = 不放寬
    "hysteresisDeg": 8,     // 防閃爍緩衝：進入範圍要 ≤ 容許角度，離開範圍要超過「容許角度 + 8」才算
    "holdGraceMs": 300,     // 靜態寬限：維持途中短暫跑出範圍不到 0.3 秒，不會中斷計時
    "checkpointWindowMs": 500, // 動態寬限：每個角度在 0.5 秒內各自到位過，就算到達檢查點（不必同一瞬間）
    "holdMs": 1500,         // 靜態動作要連續維持多久才通過（毫秒，1500 = 1.5 秒）
    "reps": 3,              // 動態動作預設要做幾次
    "repTimeoutSec": 5,     // 動態動作做到一半，超過幾秒沒到下一個檢查點，就算這次失敗、從頭開始
    "minVisibility": 0.5    // 關鍵點可信度（0～1）低於此值時，提示「請讓全身入鏡」而不判定失敗
  },

  // ── 做不到時的出口 ──
  "giveUp": {
    "timeoutSec": 60,       // 同一步超過幾秒沒通過，就顯示「跳過／放寬標準再試」
    "maxAttempts": 5,       // 或嘗試幾次沒通過，也顯示
    "relaxExtraDeg": 10     // 按「放寬標準再試」時，容許角度增加幾度
  },

  // ── 姿態估計（MediaPipe）──
  "pose": {
    "model": "lite",        // "lite"（最快）/ "full" / "heavy"（最準但最慢）
    "useGpu": true,         // 優先用 GPU 加速；手機不支援時會自動改用 CPU
    "smoothing": {          // One Euro 平滑濾波：減少骨架抖動
      "minCutoff": 1.0,     // 越小越平滑，但慢動作時反應較遲鈍
      "beta": 5.0,          // 越大，快速動作時越跟得上（延遲越小）
      "dCutoff": 1.0        // 速度估計的平滑程度，通常不用改
    }
  },

  // ── 鏡頭 ──
  "camera": {
    "facingMode": "user",   // "user" = 前鏡頭（看得到螢幕）/ "environment" = 後鏡頭
    "width": 1280,          // 希望的解析度；鏡頭不支援時瀏覽器會自動選最接近的
    "height": 720           // 手機很慢時可改成 640 × 480
  },

  // ── 畫面 ──
  "display": {
    // 左右對應方式：
    //   "mirror"   = 照畫面跟做（像照鏡子）：示範者的右手 ↔ 你的左手
    //   "sameSide" = 依口令同側：示範者的右手 ↔ 你的右手
    "mirrorMode": "mirror",
    "selfieView": true,     // 鏡頭畫面以自拍鏡像方式顯示（影片檔不鏡像）
    "skeletonWidth": 1.5,   // 骨架線條粗細，相對畫面高度的百分比（1.5 = 畫面高度的 1.5%）
    "referenceSkeleton": false, // 標準動作畫面是否畫示範者骨架與你的疊合骨架（false = 只放示範影片）
    "referenceSpeed": 0.8   // 示範影片預設播放速度（1 = 原速）；練習時可在畫面上切換
  },

  // ── 語音提示（瀏覽器內建語音，不需安裝軟體；練習畫面右上角 🔊 可開關）──
  "voice": {
    "enabled": true,        // 預設是否開啟語音
    "rate": 1.0,            // 語速（0.5 = 慢、1 = 正常、1.5 = 快）
    "correctionIntervalSec": 3, // 兩次修正提醒之間至少間隔幾秒
    "repeatSameSec": 6,     // 同一句提醒至少隔幾秒才會再講
    "minPersistMs": 800,    // 錯誤要持續多久（毫秒）才提醒，避免骨架抖一下就講話
    "notVisibleIntervalSec": 6 // 「請退後一點，讓全身入鏡」至少間隔幾秒
  },

  // ── 評分（全部練習完後顯示）──
  // 每一步的分數 = 完整度 × completionWeight + 精確度 × (1 − completionWeight)
  //   完整度：做完多少（通過 = 100；跳過時依已維持的時間或已完成的次數）
  //   精確度：角度和標準差多少。差距在「容許角度 × perfectWithin」以內 = 100 分，
  //           剛好在容許邊界 = atToleranceScore 分，超過容許角度 2 倍 = 0 分（中間線性）
  //   「跟做」的動作不判定角度，只算完整度
  "scoring": {
    "completionWeight": 0.5,
    "perfectWithin": 0.5,
    "atToleranceScore": 70
  },

  // ── 熱量估算：kcal/分鐘 = MET × 3.5 × 體重(kg) ÷ 200 ──
  "energy": {
    "met": 3.8              // 徒手體操中等強度約 3.8（參考 Compendium of Physical Activities）
  }
}
